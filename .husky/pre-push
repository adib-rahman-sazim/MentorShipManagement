#!/usr/bin/env sh
set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)

for package in api web; do
  PACKAGE_DIR="$REPO_ROOT/$package"

  if [ ! -x "$PACKAGE_DIR/node_modules/.bin/biome" ]; then
    printf 'pre-push: %s dependencies are not installed, run pnpm install\n' "$package" >&2
    exit 1
  fi

  printf '\npre-push: checking %s\n' "$package"
  cd "$PACKAGE_DIR"
  ./node_modules/.bin/biome ci . --error-on-warnings
  ./node_modules/.bin/tsc --noEmit
done

printf '\npre-push: all checks passed\n'
