{
  "name": "nextjs-starter-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.21.0"
  },
  "type": "module",
  "scripts": {
    "start:dev": "next dev -p 5000",
    "build": "next build",
    "start": "next start -p 5000",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:ci": "biome ci . --error-on-warnings",
    "postinstall": "next telemetry disable",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint-staged": "lint-staged",
    "swagger-codegen": "npx tsx ./swagger-codegen.ts"
  },
  "lint-staged": {
    "./**/*.{js,jsx,ts,tsx,json,jsonc,css}": "biome check --write --error-on-warnings --no-errors-on-unmatched"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.79",
    "@babel/core": "^7.26.9",
    "@base-ui/react": "^1.0.0",
    "@casl/ability": "^6.8.1",
    "@casl/react": "^5.0.1",
    "@hookform/resolvers": "^4.1.0",
    "@reduxjs/toolkit": "^2.5.1",
    "@tanstack/react-table": "^8.21.2",
    "ai": "^6.0.69",
    "better-auth": "~1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "i18next": "^24.2.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "next": "15.5.20",
    "next-i18next": "^15.4.2",
    "next-runtime-env": "1.7.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.4.3",
    "pluralize": "^8.0.0",
    "posthog-js": "~1.374.0",
    "react": "18.3.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^3.6.3",
    "sharp": "^0.35.3",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.1.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/node": "^22.19.3",
    "@types/pluralize": "^0.0.33",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "husky": "^8.0.3",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.4.3",
    "postcss": "^8.5.10",
    "swagger-typescript-api": "^13.0.23",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "vitest": "3.2.7",
    "vitest-mock-extended": "^2.0.2",
    "webpack": "^5.90.0"
  }
}
