engine biome(1.0)
language js(typescript, jsx)

or {
  `import $imports from "react-i18next"` as $import where {
    register_diagnostic(span=$import, message="Import translations from next-i18next, not react-i18next.")
  },
  `import "react-i18next"` as $import where {
    register_diagnostic(span=$import, message="Import translations from next-i18next, not react-i18next.")
  }
}
