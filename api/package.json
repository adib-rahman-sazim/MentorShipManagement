{
  "name": "project-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.21.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "prepare": "husky install",
    "build": "nest build",
    "build:bun": "nest build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "nest start",
    "start:dev": "dotenv -e ./.env.development.local -- nest start --watch",
    "start:dev:mailhog": "docker compose -f ./docker-compose.local.yml up -d mailhog && dotenv -e ./.env.development.local -- nest start --watch",
    "mailhog:start": "docker compose -f ./docker-compose.local.yml up -d mailhog",
    "mailhog:stop": "docker compose -f ./docker-compose.local.yml stop mailhog",
    "start:debug": "dotenv -e ./.env.development.local -- nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:bun": "bun run dist/src/main.js",
    "start:bun:dev": "dotenv -e ./.env.development.local -- bun --hot src/main.ts",
    "start:bun:debug": "dotenv -e ./.env.development.local -- bun --tsconfig-override ./tsconfig.bun.json --inspect --watch src/main.ts",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "biome:ci": "biome ci . --error-on-warnings",
    "lint-staged": "lint-staged",
    "db:migration:create": "rm ./src/db/migrations/.snapshot.json ; dotenv -e ./.env.development.local -- mikro-orm migration:create",
    "db:migration:up:dev": "dotenv -e ./.env.development.local -- mikro-orm migration:up",
    "db:migration:up:test": "dotenv -e ./.env.test.local -- mikro-orm migration:up",
    "db:migration:up:prod": "mikro-orm migration:up --config ./dist/src/db/db.config.js",
    "db:migration:down:dev": "dotenv -e ./.env.development.local -- mikro-orm migration:down",
    "db:migration:down:test": "dotenv -e ./.env.test.local -- mikro-orm migration:down",
    "db:migration:list": "dotenv -e ./.env.development.local -- mikro-orm migration:list",
    "db:migration:check": "dotenv -e ./.env.development.local -- mikro-orm migration:check",
    "db:migration:pending": "dotenv -e ./.env.development.local -- mikro-orm migration:pending",
    "db:seed:dev": "dotenv -e ./.env.development.local -- mikro-orm seeder:run",
    "db:seed:prod": "mikro-orm seeder:run --config ./dist/src/db/db.config.js",
    "db:seed:test": "dotenv -e ./.env.test.local -- mikro-orm seeder:run",
    "db:seed:dev:all": "dotenv -e ./.env.development.local -- mikro-orm seeder:run --class=DevSeeder",
    "db:seed:prod:all": "mikro-orm seeder:run --config ./dist/src/db/db.config.js --class=ProdSeeder",
    "db:migration:fresh:dev": "dotenv -e ./.env.development.local -- mikro-orm migration:fresh --seed DevSeeder",
    "db:migration:fresh:test": "dotenv -e ./.env.test.local -- mikro-orm migration:fresh",
    "db:migration:fresh:ci": "mikro-orm migration:fresh",
    "test": "dotenv -e ./.env.test.local -- vitest run",
    "test:watch": "dotenv -e ./.env.test.local -- vitest watch",
    "test:cov": "dotenv -e ./.env.test.local -- vitest run --coverage",
    "test:e2e": "dotenv -e ./.env.test.local -- vitest run --config ./vitest.e2e.config.mts",
    "test:bun": "dotenv -e ./.env.test.local -- bun test",
    "test:bun:e2e": "dotenv -e ./.env.test.local -- bun test --config-file ./vitest.e2e.config.mts",
    "stripe:listen": "docker compose -f ./docker-compose.local.yml --env-file .env.development.local up stripe-cli -d"
  },
  "dependencies": {
    "@ai-sdk/cerebras": "^2.0.34",
    "@ai-sdk/gateway": "^3.0.83",
    "@ai-sdk/google": "^3.0.22",
    "@aws-sdk/client-s3": "^3.685.0",
    "@aws-sdk/s3-request-presigner": "^3.485.0",
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "@cantoo/pdf-lib": "^2.2.3",
    "@casl/ability": "^7.0.1",
    "@mikro-orm/cli": "~6.6.16",
    "@mikro-orm/core": "~6.6.16",
    "@mikro-orm/migrations": "~6.6.16",
    "@mikro-orm/nestjs": "^6.1.2",
    "@mikro-orm/postgresql": "~6.6.16",
    "@mikro-orm/seeder": "~6.6.16",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/websockets": "11.1.28",
    "ai": "^6.0.77",
    "argon2": "^0.31.2",
    "axios": "^1.18.1",
    "better-auth": "~1.6.23",
    "bullmq": "^5.80.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dayjs": "^1.11.10",
    "dset": "^3.1.4",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "nest-winston": "^1.8.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.27.0",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pluralize": "^8.0.0",
    "posthog-node": "^5.34.1",
    "reflect-metadata": "^0.1.13",
    "resend": "^4.8.0",
    "rxjs": "^7.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^19.1.0",
    "uuidv4": "^6.2.13",
    "winston": "^3.16.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@better-auth/core": "~1.6.23",
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^17.4.2",
    "@commitlint/config-conventional": "^17.4.2",
    "@commitlint/types": "^17.8.1",
    "@faker-js/faker": "^8.4.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.1.28",
    "@opentelemetry/api": "^1.9.0",
    "@swc/core": "^1.7.26",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.3",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pluralize": "^0.0.33",
    "@types/supertest": "^6.0.2",
    "@types/timezoned-date": "^3.0.2",
    "@vitest/coverage-v8": "3.2.7",
    "dotenv-cli": "^7.3.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.0",
    "mockdate": "^3.0.5",
    "source-map-support": "^0.5.20",
    "supertest": "^6.3.4",
    "timezoned-date": "^3.0.2",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "3.2.7",
    "vitest-mock-extended": "^2.0.2"
  },
  "lint-staged": {
    "./**/*.{js,jsx,ts,tsx,json,jsonc}": "biome check --write --error-on-warnings --no-errors-on-unmatched"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": ["./src/db/db.config.ts"]
  }
}
