# local, development, test, production
NODE_ENV=production
STAGE_ENV=development

BE_PORT=3000
BE_WS_PORT=3001

API_BASE_URL=http://localhost:3000
API_HEALTH_URL=http://localhost:3000/api/health

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_dev_db?schema=public

AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=http://localhost:4566
AWS_S3_BUCKET_NAME=project-dev-bucket
AWS_S3_PRESIGN_URL_EXPIRY_IN_MINUTES=5

# this URL contains the region, bucket name, and domain of S3
# e.g. 
#   https://<project-name>.<region>.amazonaws.com
#   https://<project-name>.<region>.cdn.digitaloceanspaces.com
AWS_S3_BUCKET_URL=http://localhost:4566

EMAIL_PROVIDER=mailhog
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxx
# optional; MailhogEmailService defaults to localhost:1025
# MAILHOG_HOST=localhost
# MAILHOG_PORT=1025
SEND_FROM_EMAIL=noreply@example.com

ENABLE_AUDIT_LOGGING=false

GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET

WEB_CLIENT_BASE_URL=http://localhost:5000

# Session configuration (in seconds)
# How long a session remains valid before expiring (default: 604800 = 7 days)
SESSION_EXPIRES_IN=604800
# How often the session is refreshed/updated (default: 86400 = 1 day)
SESSION_UPDATE_AGE=86400

OPENAI_API_KEY="your-openai-api-key"
OPENAI_VECTOR_STORE_ID="your-openai-vector-store-id"

# AI SDK Configuration
AI_PROVIDER="ai-gateway"
AI_API_KEY="your-ai-api-key"
AI_GATEWAY_API_KEY="your-ai-gateway-api-key"
AI_DEFAULT_MODEL="openai/gpt-4o-mini"
GOOGLE_GEN_AI_API_KEY="your-google-gen-ai-api-key"

STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_WEBHOOK_FORWARD_URL=http://localhost:3000/api/v1/payments/webhook

# Redis (CASL ability rule cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
CASL_CACHE_TTL_SECONDS=300

# Redis queues (BullMQ)
REDIS_QUEUE_PREFIX=project-dev
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=1000
QUEUE_COMPLETED_JOB_RETENTION=3600
QUEUE_FAILED_JOB_RETENTION=86400
QUEUE_PROCESSOR_CONCURRENCY=5

# Bull Board is mounted at /admin/queues only in local/development/test when enabled.
ENABLE_BULL_BOARD=false
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin

# PostHog (feature flags). Leave POSTHOG_API_KEY empty to disable evaluation.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
