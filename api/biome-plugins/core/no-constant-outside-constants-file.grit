engine biome(1.0)
language js(typescript, jsx)

or {
  `const $name = $value` as $constant where {
    $name <: r"^[A-Z][A-Z0-9_]*$",
    not $filename <: r".*shared/typedefs/.*",
    not $filename <: r".*shared/components/shadui/.*",
    not $filename <: r".*__tests__/.*",
    not $filename <: r".*\.test\.tsx?$",
    not $filename <: r".*\.spec\.tsx?$",
    not $filename <: r".*\.mock\.tsx?$",
    not $filename <: r".*\.constants\.ts$",
    register_diagnostic(span=$constant, message="Constants must be declared only in .constants.ts files.")
  },
  `const $name: $type = $value` as $constant where {
    $name <: r"^[A-Z][A-Z0-9_]*$",
    not $filename <: r".*shared/typedefs/.*",
    not $filename <: r".*shared/components/shadui/.*",
    not $filename <: r".*__tests__/.*",
    not $filename <: r".*\.test\.tsx?$",
    not $filename <: r".*\.spec\.tsx?$",
    not $filename <: r".*\.mock\.tsx?$",
    not $filename <: r".*\.constants\.ts$",
    register_diagnostic(span=$constant, message="Constants must be declared only in .constants.ts files.")
  }
}
